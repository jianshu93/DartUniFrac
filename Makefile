# Build and test targets for the C ABI (crates/dartunifrac-capi). The CLI is
# built with cargo directly.

# rust-toolchain.toml pins nightly for the CLI's anndists dependency. The
# library crates build on stable, and RUSTUP_TOOLCHAIN takes precedence over
# the toolchain file.
export RUSTUP_TOOLCHAIN ?= stable

CARGO ?= cargo
CC ?= cc
CXX ?= c++

TARGET_DIR := $(or $(CARGO_TARGET_DIR),target)
HEADER := include/dartunifrac.h
HARNESS := $(TARGET_DIR)/debug/df_harness
HARNESS_SRC := crates/dartunifrac-capi/ctest/harness.c
VALGRIND_SUPP := crates/dartunifrac-capi/ctest/valgrind.supp
# Linked by path: with no cdylib beside it, there is no shared object for the
# linker to prefer, and the harness is self-contained for valgrind.
STATICLIB := $(TARGET_DIR)/debug/libdartunifrac_capi.a
HARNESS_CFLAGS := -std=c11 -Wall -Wextra -Werror -Iinclude
# What the staticlib needs from the platform, per
# `cargo rustc -p dartunifrac-capi --crate-type staticlib -- --print native-static-libs`.
# On macOS that includes CoreFoundation, which chrono (through arrow-array) uses
# to read the system time zone.
ifeq ($(shell uname -s),Darwin)
HARNESS_LDLIBS := -liconv -framework CoreFoundation -lSystem -lc -lm
else
HARNESS_LDLIBS := -lpthread -ldl -lm
endif

.PHONY: capi ctest leaks

# Build the staticlib; build.rs writes the header. build.rs reruns only when its
# inputs change, so a deleted header is regenerated by touching build.rs.
capi:
	@test -f $(HEADER) || touch crates/dartunifrac-capi/build.rs
	DF_HEADER_DIR="$(CURDIR)/include" $(CARGO) build -p dartunifrac-capi

# Compile the C harness against the staticlib: the header compiles as C11, the
# layouts match, the library links. The header must also compile as C++, since
# the consumer (DuckDB) includes it from C++.
$(HARNESS): capi $(HARNESS_SRC)
	echo '#include "dartunifrac.h"' | $(CXX) -std=c++11 -Wall -Wextra -Werror -Iinclude -fsyntax-only -x c++ -
	$(CC) $(HARNESS_CFLAGS) $(HARNESS_SRC) $(STATICLIB) $(HARNESS_LDLIBS) -o $(HARNESS)

ctest: $(HARNESS)
	$(HARNESS)

# The same harness under valgrind. Valgrind's default leak kinds stay on, so a
# "possibly lost" block in our own code fails the gate; the suppressions file
# says what little it hides.
leaks: $(HARNESS)
	valgrind --error-exitcode=1 --leak-check=full --suppressions=$(VALGRIND_SUPP) $(HARNESS)
